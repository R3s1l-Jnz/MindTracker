diff --git a/scripts/setup-github-signing.sh b/scripts/setup-github-signing.sh
new file mode 100755
index 0000000..045a4fa
--- /dev/null
+++ b/scripts/setup-github-signing.sh
@@ -0,0 +1,65 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+for cmd in gh keytool openssl base64; do
+  command -v "$cmd" >/dev/null || { echo "Fehlt: $cmd" >&2; exit 1; }
+done
+
+gh auth status >/dev/null
+
+KEYSTORE="$PWD/.mindtrack-signing.jks"
+CREDENTIALS="$PWD/.mindtrack-signing-credentials.txt"
+
+if [[ -e "$KEYSTORE" || -e "$CREDENTIALS" ]]; then
+  echo "Abbruch: Signing-Backup existiert bereits:" >&2
+  echo "  $KEYSTORE" >&2
+  echo "  $CREDENTIALS" >&2
+  echo "Bitte zuerst sichern/umbenennen, damit kein Schlüssel überschrieben wird." >&2
+  exit 1
+fi
+
+PASSWORD="$(openssl rand -hex 24)"
+
+keytool -genkeypair \
+  -keystore "$KEYSTORE" \
+  -storetype JKS \
+  -storepass "$PASSWORD" \
+  -keypass "$PASSWORD" \
+  -alias mindtrack \
+  -keyalg RSA \
+  -keysize 2048 \
+  -validity 10000 \
+  -dname "CN=MindTrack Development, OU=Development, O=MindTrack, L=Local, ST=Local, C=DE" \
+  >/dev/null
+
+if base64 --help 2>&1 | grep -q -- '-w'; then
+  KEYSTORE_B64="$(base64 -w0 "$KEYSTORE")"
+else
+  KEYSTORE_B64="$(base64 "$KEYSTORE" | tr -d '\n')"
+fi
+
+printf '%s' "$KEYSTORE_B64" | gh secret set MINDTRACK_KEYSTORE_B64
+printf '%s' "$PASSWORD" | gh secret set MINDTRACK_KEYSTORE_PASSWORD
+
+cat > "$CREDENTIALS" <<CREDS
+MindTrack development signing key
+Alias: mindtrack
+Keystore password: $PASSWORD
+Key password: $PASSWORD
+Created: $(date -u +%Y-%m-%dT%H:%M:%SZ)
+CREDS
+chmod 600 "$KEYSTORE" "$CREDENTIALS"
+
+cat <<MSG
+
+Feste MindTrack-Signatur ist eingerichtet.
+
+WICHTIG: Lade diese beiden Dateien aus dem Codespace herunter und bewahre sie sicher auf:
+  $KEYSTORE
+  $CREDENTIALS
+
+Sie sind absichtlich per .gitignore vom Repository ausgeschlossen.
+Wenn du den Keystore verlierst, kannst du bereits installierte Builds später nicht mehr normal aktualisieren.
+
+Jetzt committe/pushe den 0.3.3-Patch und starte den Build erneut.
+MSG
